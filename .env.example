POSTGRES_DB=person
POSTGRES_USER=person
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgres://person:change_me@localhost:5432/person?sslmode=disable
COMPOSE_DATABASE_URL=postgres://person:change_me@postgres:5432/person?sslmode=disable
MIGRATE_DATABASE_URL=postgres://person:change_me@postgres:5432/person?sslmode=disable
TEST_DATABASE_URL=postgres://person:change_me@localhost:5432/person_test?sslmode=disable
MIGRATE_TEST_DATABASE_URL=postgres://person:change_me@postgres:5432/person_test?sslmode=disable

HTTP_ADDRESS=:8080
HTTP_CONTAINER_PORT=8080
HTTP_HOST_PORT=8080
HTTP_GRACEFUL_TIMEOUT=10s
HTTP_CONTEXT_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=15m
DB_PING_TIMEOUT=5s

LOG_LEVEL=info
LOG_FORMAT=json
